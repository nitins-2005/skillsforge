<% layout("/layouts/boilerplate") %>
<div class="container mt-5">
    <h1>welcome admin`s</h1>
    <div class="row row-cols-lg-4 row-cols-md-2  row-cols-sm-1">
        <% for(let sub of pendingSub) { %>
            <a href="/admin/<%= sub._id %>/approve" style="text-decoration: none ;">
                <div class="col-md-12 mb-3 shadow-sm p-3">
                    <h6>
                       user :<%= sub.userId %>
                    </h6>
                    <h6>
                       task :<%= sub.task %>
                    </h6>
                    <h6>
                       status :<%= sub.status %>
                    </h6>
                </div>
            </a>
            <% } %>
    </div>
</div>